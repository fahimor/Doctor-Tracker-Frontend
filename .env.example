# Copy to .env.local for local development:  cp .env.example .env.local
# On Vercel, add these under Project → Settings → Environment Variables.

# Base URL of the Express API (no trailing slash, no /api).
# Next.js forwards every browser request to /api/* to this server.
#   local:      http://localhost:8080
#   production: https://doctor-tracker-api-xxxxxxxx-as.a.run.app
API_PROXY_TARGET=http://localhost:8080

# Optional but recommended in production: the SAME value as the backend's JWT_SECRET.
# When set, src/proxy.ts verifies the session signature before rendering protected pages.
# When unset, it only checks that a non-expired token exists (the API still verifies everything).
# JWT_SECRET=

# Must match the backend's COOKIE_NAME (default: dt_session)
# SESSION_COOKIE_NAME=dt_session

# Show the "Demo accounts" quick-fill buttons on the login page (default: shown)
NEXT_PUBLIC_SHOW_DEMO_ACCOUNTS=true
